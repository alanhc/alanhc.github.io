&lt;a href="#ref" class="subheading-anchor" aria-label="Permalink for this section"&gt;&lt;/a&gt;&lt;/h2&gt;&lt;ul&gt;
&lt;li&gt;&lt;a href="https://youtu.be/gvOOgqcpbvU?si=GVwLMdc0DqtdpWC2"target="_blank" rel="noopener"&gt;https://youtu.be/gvOOgqcpbvU?si=GVwLMdc0DqtdpWC2&lt;/a&gt;&lt;/li&gt;
