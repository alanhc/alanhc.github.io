&lt;code&gt;docker pull jupyter/tensorflow-notebook&lt;/code&gt;
&lt;code&gt;docker run jupyter/tensorflow-notebook -p 8000:8888&lt;/code&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;-p out:in&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Transformers
&lt;code&gt;from transformers import pipeline&lt;/code&gt;
&lt;code&gt;pip install transformers&lt;/code&gt;&lt;/p&gt;
